# Canonical site URL used for canonical links, Open Graph URLs and the sitemap.
# Override this in Cloudflare Pages / CI. No trailing slash.
SITE_URL=https://penghou.pages.dev

# Optional base path for sub-path deployments, such as a GitHub project site.
# Defaults to "/". For https://<user>.github.io/website/ use /website.
# BASE_PATH=/website
