---
import { RUNTIME_LAYERS } from '../lib/ecosystem';
---

<ol class="layers">
  {
    RUNTIME_LAYERS.map((layer, i) => (
      <li class:list={['layer', { 'layer--adjunct': layer.adjunct }]}>
        <span class="layer__rail" aria-hidden="true">
          <span class="layer__node" />
        </span>
        <div class="layer__body">
          <span class="layer__index" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="layer__name">
            {layer.name}
            {layer.adjunct && <span class="layer__tag">runs inside execution</span>}
          </h3>
          <p class="layer__plain">{layer.plain}</p>
          <p class="layer__detail">{layer.detail}</p>
          {layer.projects.length > 0 && (
            <ul class="layer__projects">
              {layer.projects.map((p) => (
                <li>
                  <a href={p.href}>{p.label}</a>
                </li>
              ))}
            </ul>
          )}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .layers {
    list-style: none;
    display: grid;
    gap: var(--space-5);
  }

  .layer {
    display: grid;
    grid-template-columns: 1.25rem 1fr;
    gap: var(--space-4);
  }

  .layer__rail {
    position: relative;
    display: block;
  }

  .layer__rail::before {
    content: '';
    position: absolute;
    top: 0.35rem;
    bottom: calc(-1 * var(--space-5));
    left: 50%;
    width: 1px;
    transform: translateX(-50%);
    background-image: linear-gradient(
      var(--color-line-strong) 45%,
      transparent 45%
    );
    background-size: 1px 7px;
  }

  .layer:last-child .layer__rail::before {
    display: none;
  }

  .layer__node {
    position: absolute;
    top: 0.35rem;
    left: 50%;
    width: 0.5rem;
    height: 0.5rem;
    transform: translateX(-50%) rotate(45deg);
    background-color: var(--color-vermilion);
  }

  .layer--adjunct .layer__node {
    background-color: transparent;
    box-shadow: inset 0 0 0 1.5px var(--color-vermilion);
  }

  .layer__body {
    padding-bottom: var(--space-2);
  }

  .layer__index {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    color: var(--color-ink-muted);
  }

  .layer__name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
    margin-top: var(--space-1);
    font-size: var(--text-lg);
  }

  .layer__tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-vermilion);
  }

  .layer__plain {
    margin-top: var(--space-2);
    max-width: var(--measure);
    color: var(--color-ink);
  }

  .layer__detail {
    margin-top: var(--space-2);
    max-width: var(--measure);
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }

  .layer__projects {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-3);
    list-style: none;
    font-size: var(--text-sm);
  }
</style>
