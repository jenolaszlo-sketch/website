---
interface Props {
  index: number;
  title: string;
  summary: string;
}

const { index, title, summary } = Astro.props;
const display = String(index).padStart(2, '0');
---

<li class="principle">
  <span class="principle__index" aria-hidden="true">{display}</span>
  <h3 class="principle__title">{title}</h3>
  <p class="principle__summary">{summary}</p>
</li>

<style>
  .principle {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: var(--image-width) solid var(--color-vermilion);
  }

  .principle__index {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    color: var(--color-vermilion);
  }

  .principle__title {
    font-size: var(--text-lg);
  }

  .principle__summary {
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }
</style>
